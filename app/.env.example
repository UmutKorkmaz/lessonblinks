# Public site URL (used for Blink links and action metadata)
NEXT_PUBLIC_BASE_URL=https://blinks.umutkorkmaz.net

# Solana RPC endpoint (devnet recommended for lessons 1–2)
SOLANA_RPC_URL=https://api.devnet.solana.com
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com

# Cluster: devnet | mainnet-beta
SOLANA_CLUSTER=devnet

# Creator wallet that receives lesson tips
CREATOR_WALLET_PUBKEY=

# USDC mint (mainnet default; use devnet USDC mint for devnet testing)
USDC_MINT=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU

# Completion store for verified lessons and graduation claims
COMPLETION_STORE_PROVIDER=file
COMPLETION_STORE_FILE=data/completion-store.json

# Salt for sponsor-safe wallet hashes. Use a private random value in production.
WALLET_REPORT_SALT=lessonblinks-local
